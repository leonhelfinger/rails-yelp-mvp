<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="card-title mb-4">Add a review for <%= @restaurant.name %></h2>

          <%= simple_form_for([@restaurant, @review]) do |f| %>
            <%= f.error_notification %>

            <%= f.input :content, as: :text, placeholder: "Write your review here...", input_html: { rows: 4 } %>
            <%= f.input :rating, collection: (0..5), prompt: "Select a rating (0 to 5)" %>

            <div class="d-flex justify-content-between align-items-center mt-4">
              <%= f.button :submit, "Submit Review", class: "btn btn-primary" %>
              <%= link_to "Cancel", restaurant_path(@restaurant), class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

