<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Restaurants</h1>
    <%= link_to "Add a new restaurant", new_restaurant_path, class: "btn btn-primary" %>
  </div>

  <div class="list-group">
    <% @restaurants.each do |restaurant| %>
      <%= link_to restaurant_path(restaurant), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
        <div>
          <h5 class="mb-1"><%= restaurant.name %></h5>
          <p class="mb-1 text-muted"><%= restaurant.address %></p>
        </div>
        <span class="badge bg-secondary text-uppercase"><%= restaurant.category %></span>
      <% end %>
    <% end %>
  </div>
</div>

