<div class="container mt-4">
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h1 class="card-title"><%= @restaurant.name %></h1>
          <p class="card-text text-muted"><strong>Address:</strong> <%= @restaurant.address %></p>
          <p class="card-text text-muted"><strong>Phone:</strong> <%= @restaurant.phone_number %></p>
        </div>
        <span class="badge bg-primary text-uppercase fs-6"><%= @restaurant.category %></span>
      </div>
      <div class="mt-3">
        <%= link_to "Back to restaurants", restaurants_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-header bg-white">
      <h3 class="mb-0">Add a review</h3>
    </div>
    <div class="card-body">
      <%= simple_form_for([@restaurant, @review]) do |f| %>
        <%= f.error_notification %>

        <%= f.input :content, as: :text, placeholder: "Write your review here...", input_html: { rows: 3 } %>
        <%= f.input :rating, collection: (0..5), prompt: "Select a rating (0 to 5)" %>

        <%= f.button :submit, "Submit Review", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <h3 class="mb-0">Reviews (<%= @restaurant.reviews.count %>)</h3>
    </div>
    <ul class="list-group list-group-flush">
      <% if @restaurant.reviews.any? %>
        <% @restaurant.reviews.each do |review| %>
          <li class="list-group-item">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div>
                <% review.rating.times do %>⭐<% end %>
                <span class="text-muted small ms-1">(<%= review.rating %>/5)</span>
              </div>
              <small class="text-muted"><%= review.created_at ? review.created_at.strftime("%b %d, %Y") : "" %></small>
            </div>
            <p class="mb-0"><%= review.content %></p>
          </li>
        <% end %>
      <% else %>
        <li class="list-group-item text-muted">No reviews yet. Be the first to review!</li>
      <% end %>
    </ul>
  </div>
</div>

